EXOCORD_ENV=development
EXOCORD_BIND=127.0.0.1:4100
EXOCORD_API_URL=http://127.0.0.1:4100
EXOCORD_DATABASE_URL=postgres://exocord:exocord@127.0.0.1:5432/exocord
EXOCORD_DATABASE_MAX_CONNECTIONS=20
EXOCORD_NATS_URL=nats://127.0.0.1:4222
EXOCORD_DRAGONFLY_URL=redis://127.0.0.1:6379
EXOCORD_DEV_USER_ID=1
EXOCORD_LOG=info,exo_monolith=debug
EXOCORD_STATE_DIR=.exocord
EXOCORD_ALLOW_DEV_AUTH=1

# Attachment storage. Development uses EXOCORD_STATE_DIR/attachments and the
# API origin below. Production enables direct R2 uploads only when all six R2
# values are present.
EXOCORD_PUBLIC_API_URL=http://127.0.0.1:4100
EXOCORD_R2_ENDPOINT=
EXOCORD_R2_BUCKET=
EXOCORD_R2_ACCESS_KEY_ID=
EXOCORD_R2_SECRET_ACCESS_KEY=
EXOCORD_CDN_URL=
# 32 random bytes encoded as unpadded base64url. Keeps content-addressed object
# names unguessable even when an attacker already knows a file's SHA-256.
EXOCORD_ATTACHMENT_OBJECT_KEY=

# Self-hosted LiveKit. Development defaults to ws://127.0.0.1:7880 with the
# official devkey/secret pair when these are empty. Production should use wss.
EXOCORD_LIVEKIT_URL=
EXOCORD_LIVEKIT_API_KEY=
EXOCORD_LIVEKIT_API_SECRET=

# Set both to deliver passwordless sign-in codes through Resend.
EXOCORD_RESEND_API_KEY=
EXOCORD_EMAIL_FROM=

# Sign in with Apple. All six values are required before the provider is shown.
EXOCORD_APPLE_CLIENT_ID=
EXOCORD_APPLE_TEAM_ID=
EXOCORD_APPLE_KEY_ID=
EXOCORD_APPLE_PRIVATE_KEY_FILE=
EXOCORD_APPLE_REDIRECT_URI=
# 32 random bytes encoded as unpadded base64url. Encrypts Apple refresh tokens
# and the one-time native handoff payload at rest.
EXOCORD_PROVIDER_TOKEN_KEY=

# Optional Discord account linking. Never put a client secret in the renderer.
EXOCORD_DISCORD_CLIENT_ID=
EXOCORD_DISCORD_CLIENT_SECRET=
EXOCORD_DISCORD_REDIRECT_URI=http://127.0.0.1/callback
