# Required production mode. The API should bind privately behind an HTTPS
# reverse proxy; only that proxy and the LiveKit/TURN ports are public.
EXOCORD_ENV=production
EXOCORD_BIND=127.0.0.1:4100
EXOCORD_PUBLIC_API_URL=https://alpha.example.com
EXOCORD_TRUST_PROXY_HEADERS=1
EXOCORD_ALLOWED_ORIGINS=http://tauri.localhost
EXOCORD_STATE_DIR=/var/lib/exocord
EXOCORD_LOG=info,exo_monolith=info

# Public operator identity shown before login and in Privacy & interface.
EXOCORD_OPERATOR_NAME=Exocord Friends Alpha
EXOCORD_PRIVACY_URL=https://alpha.example.com/privacy
EXOCORD_TERMS_URL=https://alpha.example.com/terms
EXOCORD_SUPPORT_EMAIL=help@alpha.example.com
EXOCORD_ABUSE_EMAIL=abuse@alpha.example.com

# Durable application data.
# Either set EXOCORD_DATABASE_URL directly, point EXOCORD_DATABASE_URL_FILE at
# a protected file, or use the component form shown here.
EXOCORD_DATABASE_HOST=postgres.internal
EXOCORD_DATABASE_PORT=5432
EXOCORD_DATABASE_USER=exocord
EXOCORD_DATABASE_NAME=exocord
EXOCORD_DATABASE_PASSWORD_FILE=/run/secrets/postgres-password
EXOCORD_DATABASE_MAX_CONNECTIONS=20

# Passwordless email. Production refuses to start without both values.

# R2-compatible attachment storage. All six values are required.
EXOCORD_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
EXOCORD_R2_BUCKET=exocord-alpha
EXOCORD_R2_ACCESS_KEY_ID_FILE=/run/secrets/r2-access-key-id
EXOCORD_R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2-secret-access-key
EXOCORD_CDN_URL=https://media.alpha.example.com
EXOCORD_ATTACHMENT_OBJECT_KEY_FILE=/run/secrets/attachment-object-key

# LiveKit/TURN. Production refuses to start without all three values.
EXOCORD_LIVEKIT_URL=wss://voice.alpha.example.com
EXOCORD_LIVEKIT_API_KEY_FILE=/run/secrets/livekit-api-key
EXOCORD_LIVEKIT_API_SECRET_FILE=/run/secrets/livekit-api-secret

# Independent 32-byte unpadded-base64url server secret for message franking.
EXOCORD_FRANKING_KEY_FILE=/run/secrets/franking-key

# Optional Sign in with Apple. Email login works when all six are absent. Apple
# appears only when all six values are configured; a partial set fails startup.
EXOCORD_APPLE_CLIENT_ID=
EXOCORD_APPLE_TEAM_ID=
EXOCORD_APPLE_KEY_ID=
EXOCORD_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple-private-key.p8
EXOCORD_APPLE_REDIRECT_URI=https://alpha.example.com/v1/auth/apple/callback
EXOCORD_PROVIDER_TOKEN_KEY_FILE=/run/secrets/provider-token-key
