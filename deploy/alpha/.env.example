# Public HTTPS API origin. Point this DNS name at the API VM.
EXOCORD_DOMAIN=alpha.example.com
ACME_EMAIL=owner@example.com

# Leave this bootstrap value in the first copy. deploy-alpha.sh replaces it
# with a unique immutable tag, such as git-a1b2c3d4e5f6. Keeping old tagged
# images makes an immediate application rollback possible.
EXOCORD_IMAGE_TAG=bootstrap-unbuilt

# Public operator identity shown before login and in Privacy & interface.
EXOCORD_OPERATOR_NAME=Exocord Friends Alpha
EXOCORD_PRIVACY_URL=https://alpha.example.com/privacy
EXOCORD_TERMS_URL=https://alpha.example.com/terms
EXOCORD_SUPPORT_EMAIL=help@alpha.example.com
EXOCORD_ABUSE_EMAIL=abuse@alpha.example.com

# Secrets are mounted from deploy/alpha/secrets, never interpolated into the
# container environment. Run scripts/init-secrets.sh before Compose.
POSTGRES_DB=exocord
POSTGRES_USER=exocord
EXOCORD_DATABASE_MAX_CONNECTIONS=20

EXOCORD_ALLOWED_ORIGINS=http://tauri.localhost

# Local encrypted-attachment storage is the zero-provider alpha default.
# Five GiB leaves room for the OS, database, images, and rotating backups on
# the 50 GB Oracle boot disk. Raise this only with disk monitoring in place.
EXOCORD_ATTACHMENT_MAX_STORAGE_BYTES=5368709120
# Daily PostgreSQL/auth/attachment backups share the same 50 GB boot disk
# until they are copied off-host. Exactly three complete sets are kept locally.
EXOCORD_BACKUP_RETENTION_SETS=3

# Use the API key pair created by the separate LiveKit deployment.
EXOCORD_LIVEKIT_URL=wss://voice.example.com

EXOCORD_LOG=info,exo_monolith=info

# Optional Apple override values.
EXOCORD_APPLE_CLIENT_ID=
EXOCORD_APPLE_TEAM_ID=
EXOCORD_APPLE_KEY_ID=
